[
    uuid(469e07f7-045a-48d5-aa12-68a478cdf75d),
    object,
    local,
]
interface ID3D11ModuleInstance : IUnknown
{
    HRESULT BindConstantBuffer(UINT src_slot, UINT dst_slot, UINT dst_offset);
    HRESULT BindConstantBufferByName(const char *name, UINT dst_slot, UINT dst_offset);
    HRESULT BindResource(UINT src_slot, UINT dst_slot, UINT count);
    HRESULT BindResourceByName(const char *name, UINT dst_slot, UINT count);
    HRESULT BindSampler(UINT src_slot,  UINT dst_slot,  UINT count);
    HRESULT BindSamplerByName(const char *name,  UINT dst_slot, UINT count);
    HRESULT BindUnorderedAccessView(UINT src_slot,  UINT dst_slot, UINT count);
    HRESULT BindUnorderedAccessViewByName(const char *name, UINT dst_slot, UINT count);
    HRESULT BindResourceAsUnorderedAccessView(UINT src_slot, UINT dst_slot, UINT count);
    HRESULT BindResourceAsUnorderedAccessViewByName(const char *name, UINT dst_slot, UINT count);
}

[
    uuid(cac701ee-80fc-4122-8242-10b39c8cec34),
    object,
    local,
]
interface ID3D11Module : IUnknown
{
    HRESULT CreateInstance(const char *instance_namespace, ID3D11ModuleInstance **instance);
}

[
    uuid(59a6cd0e-e10d-4c1f-88c0-63aba1daf30e),
    object,
    local,
]
interface ID3D11Linker : IUnknown
{
    HRESULT Link(ID3D11ModuleInstance *instance, const char *instance_name,
            const char *target_name, UINT flags, ID3DBlob **shader, ID3DBlob **messages);
    HRESULT UseLibrary(ID3D11ModuleInstance *instance);
    HRESULT AddClipPlaneFromCBuffer(UINT slot, UINT entry);
}

[
    uuid(d80dd70c-8d2f-4751-94a1-03c79b3556db),
    object,
    local,
]
interface ID3D11LinkingNode : IUnknown
{
}

[
    uuid(54133220-1ce8-43d3-8236-9855c5ceecff),
    object,
    local,
]
interface ID3D11FunctionLinkingGraph : IUnknown
{
    HRESULT CreateModuleInstance(ID3D11ModuleInstance **instance, ID3DBlob **messages);
    HRESULT SetInputSignature(const D3D11_PARAMETER_DESC *parameter_desc,
            UINT parameter_count, ID3D11LinkingNode **input_node);
    HRESULT SetOutputSignature(const D3D11_PARAMETER_DESC *parameter_desc,
            UINT parameter_count, ID3D11LinkingNode **output_node);
    HRESULT CallFunction(const char *instance_namespace, ID3D11Module *function_module,
            const char *function_name, ID3D11LinkingNode **call_node);
    HRESULT PassValue(ID3D11LinkingNode *src_node, INT src_parameter_index,
            ID3D11LinkingNode *dst_node, INT dst_parameter_index);
    HRESULT PassValueWithSwizzle(ID3D11LinkingNode *src_node, INT src_parameter_index, const char *src_swizzle,
            ID3D11LinkingNode *dst_node, INT dst_parameter_index, const char *dst_swizzle);
    HRESULT GetLastError(ID3DBlob **error);
    HRESULT GenerateHlsl(UINT flags, ID3DBlob **hlsl);
}
