    HRESULT GetResourceBindingDesc(UINT index, D3D11_SHADER_INPUT_BIND_DESC *desc);
    ID3D11ShaderReflectionVariable *GetVariableByName(const char *name);
    HRESULT GetResourceBindingDescByName(const char *name, D3D11_SHADER_INPUT_BIND_DESC *desc);
    ID3D11FunctionParameterReflection *GetFunctionParameter(INT index);
}

[
    uuid(54384f1b-5b3e-4bb7-ae01-60ba3097cbb6),
