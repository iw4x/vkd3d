[require]
shader model >= 4.0

[pixel shader]
uniform uint a;

float4 main() : sv_target
{
    return f16tof32(a);
}

[test]
write cbv-0 (0) u32(0x5140)
todo(msl & sm>=6) draw quad
probe (0, 0) f32(42.0, 42.0, 42.0, 42.0)

% zero
write cbv-0 (0) u32(0x0)
todo(msl & sm>=6) draw quad
probe (0, 0) f32(0.0, 0.0, 0.0, 0.0)

% negative zero
write cbv-0 (0) u32(0x8000)
todo(msl & sm>=6) draw quad
probe (0, 0) f32(-0.0, -0.0, -0.0, -0.0)

% subnormal number
