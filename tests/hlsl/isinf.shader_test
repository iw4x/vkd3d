[pixel-shader]
float4 v;

float4 main() : sv_target
{
    return isinf(1.0f / v) + 1.0f;
}

[test]
write cbv-0 (0) f32(1.0, 0.0, -0.0, 0.0)
draw quad
probe (0, 0) f32(1.0, 2.0, 2.0, 2.0)

[require]
shader model >= 4.0

[pixel-shader]
float4 v;

float4 main() : sv_target
{
    return isinf(v) + 1.0f;
}

[test]
write cbv-0 (0) f32(1.0, 0.0, -1.0, 2.0)
draw quad
probe (0, 0) f32(1.0, 1.0, 1.0, 1.0)
write cbv-0 (0) u32(0x7f800000, 0xff800000, 0xffc00001, 0xff800001)
draw quad
probe (0, 0) f32(2.0, 2.0, 1.0, 1.0)
