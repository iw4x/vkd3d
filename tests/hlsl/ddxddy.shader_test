probe uav-0 (0, 0, 640, 480) f32(1.0, 0.0, 0.0, 1.0)

% When the threadgroup is 1D, quads are laid out differently.
[compute-shader]
RWTexture2D<float4> u;

    [numthreads(8, 1, 1)]
void main(uint3 id : SV_DispatchThreadID)
{
    u[id.xy] = float4(ddx(id.x), ddx(id.y), ddy(id.x), ddy(id.y));
}

