% When using derivatives, thread group must be a multiple of 2x2 or 4x1
[compute-shader fail]
RWTexture2D<float4> u;

    [numthreads(3, 1, 1)]
void main(uint3 id : SV_DispatchThreadID)
{
    u[id.xy] = float4(ddx(id.x), ddx(id.y), ddy(id.x), ddy(id.y));
}

[compute-shader fail]
RWTexture2D<float4> u;

    [numthreads(3, 2, 1)]
void main(uint3 id : SV_DispatchThreadID)
{
    u[id.xy] = float4(ddx(id.x), ddx(id.y), ddy(id.x), ddy(id.y));
}

[compute-shader fail]
RWTexture2D<float4> u;

    [numthreads(2, 3, 1)]
void main(uint3 id : SV_DispatchThreadID)
{
    u[id.xy] = float4(ddx(id.x), ddx(id.y), ddy(id.x), ddy(id.y));
}

[compute-shader fail]
RWTexture2D<float4> u;

    [numthreads(1, 4, 1)]
void main(uint3 id : SV_DispatchThreadID)
{
    u[id.xy] = float4(ddx(id.x), ddx(id.y), ddy(id.x), ddy(id.y));
}

[compute-shader fail]
RWTexture2D<float4> u;

    [numthreads(1, 1, 4)]
void main(uint3 id : SV_DispatchThreadID)
{
    u[id.xy] = float4(ddx(id.x), ddx(id.y), ddy(id.x), ddy(id.y));
}

[compute-shader fail]
RWTexture2D<float4> u;

    [numthreads(1, 2, 2)]
void main(uint3 id : SV_DispatchThreadID)
{
    u[id.xy] = float4(ddx(id.x), ddx(id.y), ddy(id.x), ddy(id.y));
}

[compute-shader]
RWTexture2D<float4> u;

    [numthreads(8, 8, 1)]
void main(uint3 id : SV_DispatchThreadID)
{
    float2 pos = (id.xy + 0.5) / 10.0;
    float nonlinear = pos.x * pos.y - pos.x * (pos.x + 0.5);
    float4 res = float4(nonlinear, ddx(nonlinear), ddy(nonlinear), 0.0);

    u[id.xy] = round(30 * res);
}

