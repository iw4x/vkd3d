% Repeat the same tests for compute shaders.
[require]
shader model >= 6.6

[uav-0]
format r32g32b32a32-float
size (2d, 640, 480)

[compute-shader]
RWTexture2D<float4> u;

    [numthreads(8, 8, 1)]
void main(uint3 id : SV_DispatchThreadID)
{
    u[id.xy] = float4(ddx(id.x), ddx(id.y), ddy(id.x), ddy(id.y));
}

