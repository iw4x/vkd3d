[pixel shader]
float4 main(float4 pos : sv_position) : sv_target
{
    pos /= 10.0;
    float nonlinear = pos.x * pos.y - pos.x * (pos.x + 0.5);
    return float4(nonlinear, ddx_fine(nonlinear), ddy_fine(nonlinear), 0.0);
}

