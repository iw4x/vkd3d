[test]
clear rtv-0 f32(0.0, 0.0, 0.0, 0.0)
dispatch-mesh 1 1 1
probe (0, 0, 640, 480) f32(0.25, 0.5, 0.75, 1.0)

% The DispatchMesh() call that counts is from the first active thread; it also
% implies a groupshared barrier, so all writes on other threads are collected
% together.
[amplification-shader]
struct payload_data
{
    float4 color;
};

groupshared struct payload_data p;

    [numthreads(4, 1, 1)]
void main(uint index : SV_GroupIndex) {
    switch (index)
    {
        case 0: p.color.x = 0.25; break;
        case 1: p.color.y = 0.5; break;
        case 2: p.color.z = 0.75; break;
        case 3: p.color.w = 1.0; break;
    }

    uint x = 1;
    if (index == 0)
        x = 2;

    DispatchMesh(x, 1, 1, p);
}

[mesh-shader]
struct payload_data
{
    float4 color;
};

struct vertex_out
{
    float4 position : SV_Position;
    float4 color : COLOR;
};

static const float4 positions[4] =
{
    float4(-1.0, -1.0, 0.0, 1.0),
    float4(-1.0,  1.0, 0.0, 1.0),
    float4( 1.0,  1.0, 0.0, 1.0),
    float4( 1.0, -1.0, 0.0, 1.0),
};

static const uint3 triangles[2] =
{
    uint3(0, 1, 3),
    uint3(1, 2, 3),
};

    [outputtopology("triangle")]
    [numthreads(4, 1, 1)]
void main(in payload payload_data p, out vertices vertex_out verts[4],
        out indices uint3 indices[2], uint index : SV_GroupIndex, uint3 group_id : SV_GroupID)
{
    SetMeshOutputCounts(4, 1);

    verts[index].position = positions[index];
    verts[index].color = p.color;

    if (index == 0)
        indices[0] = triangles[group_id.x];
}

[test]
clear rtv-0 f32(0.0, 0.0, 0.0, 0.0)
dispatch-mesh 1 1 1
probe (0, 0, 640, 480) f32(0.25, 0.5, 0.75, 1.0)

% The payload is just a bag of bytes; the runtime checks that the
% amplification and mesh shaders agree on its size, but the internal structure
% doesn't need to match.
[amplification-shader]
struct payload_data
{
    uint2 color01;
    uint color23[2];
};

groupshared struct payload_data p;

    [numthreads(1, 1, 1)]
void main()
{
    p.color01.x = asuint(0.25f);
    p.color01.y = asuint(0.5f);
    p.color23[0] = asuint(0.75f);
    p.color23[1] = asuint(1.0f);
    DispatchMesh(1, 1, 1, p);
}

