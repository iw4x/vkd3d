}

[test]
clear rtv-0 f32(0.0, 0.0, 0.0, 0.0)
dispatch-mesh 1 1 1
probe (0, 0, 640, 480) f32(0.25, 0.5, 0.75, 1.0)

% Test type size and alignment in the amplification shader payload.
% DXIL doesn't support char, so we put a uint16_t before and after the type to
% check to observe its size and alignment.
% Usually we don't care too much about alignment in DXIL, because in most
% cases where alignment is relevant it is determined by external factors, such
% as the need to fit or pack components in registers. However, the
% amplification shader payload behaves more similar to how C structures are
% laid out on most CPUs: a linear space where fields are allocated
% incrementally according to their sizes and alignments.
% The result is that all numeric types have their obvious size and matching
% alignment. The only exception is bool, which has size and alignment 4.
% Moreover, vector types have the same alignment as their scalar counterparts.
% Scalar types are not explicitly tested, because it is assumed they won't
% have stricter alignment than vector types anyway. In the DXIL bytecode
% vector types are lowered to scalars.
% Unfortunately tests in this section crash on AMD GPUs. On the Steam Deck the
% crash is vary bad and takes down the whole operating system. On other GPUs
% they just (non deterministically) cause GPU resets.

[require]
shader model >= 6.5
mesh-shader
native-16-bit

[amplification-shader]
struct payload_data
{
    uint16_t before;
    bool4 test;
    uint16_t after;
};

groupshared struct payload_data p;

    [numthreads(1, 1, 1)]
void main()
{
    p.before = 0xabab;
    p.test.xw = true;
    p.test.yz = false;
    p.after = 0xcdcd;

    DispatchMesh(1, 1, 1, p);
}

[mesh-shader]
struct payload_data
{
    uint16_t data[12];
};

struct vertex_out
{
    float4 position : SV_Position;
    float4 color : COLOR;
};

static const float4 positions[4] =
{
    float4(-1.0, -1.0, 0.0, 1.0),
    float4(-1.0,  1.0, 0.0, 1.0),
    float4( 1.0,  1.0, 0.0, 1.0),
    float4( 1.0, -1.0, 0.0, 1.0),
};

static const uint3 triangles[2] =
{
    uint3(0, 1, 3),
    uint3(1, 2, 3),
};

    [outputtopology("triangle")]
    [numthreads(4, 1, 1)]
void main(in payload payload_data p, out vertices vertex_out verts[4],
        out indices uint3 indices[2], uint index : SV_GroupIndex)
{
    if (p.data[0] != 0xabab
            || p.data[2] != 1
            || p.data[3] != 0
            || p.data[4] != 0
            || p.data[5] != 0
            || p.data[6] != 0
            || p.data[7] != 0
            || p.data[8] != 1
            || p.data[9] != 0
            || p.data[10] != 0xcdcd)
    {
        return;
    }

    SetMeshOutputCounts(4, 2);

    verts[index].position = positions[index];
    verts[index].color = float4(0.25, 0.5, 0.75, 1.0);

    if (index < 2)
        indices[index] = triangles[index];
}

[test]
clear rtv-0 f32(0.0, 0.0, 0.0, 0.0)
winbug(amd) dispatch-mesh 1 1 1
winbug(amd) probe (0, 0, 640, 480) f32(0.25, 0.5, 0.75, 1.0)

