% Test alignments when structures and arrays are involved; the behaviour is
% what is probably the common expectation, and the fact that vector types
% don't have stronger alignment than corresponding scalars is checked again.
[amplification-shader]
struct payload_data
{
    struct
    {
        uint b;
        struct
        {
            uint d;
            uint64_t e;
        } c;
    } a;

    struct
    {
        uint16_t g;
        uint h;
        uint64_t i;
        uint16_t j;
    } f[2];

    uint16_t k;

    struct
    {
        uint m;
        struct
        {
            uint o;
            uint64_t4 p;
        } n;
    } l;
};

groupshared struct payload_data p;

    [numthreads(1, 1, 1)]
void main()
{
    p.a.b = 0xa1a2a3a4;
    p.a.c.d = 0xb1b2b3b4;
    p.a.c.e = 0xc1c2c3c4c5c6c7c8;

    p.f[0].g = 0xd1d2;
    p.f[0].h = 0xe1e2e3e4;
    p.f[0].i = 0xf1f2f3f4f5f6f7f8;
    p.f[0].j = 0x1112;

    p.f[1].g = 0xd3d4;
    p.f[1].h = 0xe5e6e7e8;
    p.f[1].i = 0xf9fafbfcfdfefff0;
    p.f[1].j = 0x1314;

    p.k = 0x2122;

    p.l.m = 0x31323334;
    p.l.n.o = 0x41424344;
    p.l.n.p = 0x5152535455565758;

    DispatchMesh(1, 1, 1, p);
}

