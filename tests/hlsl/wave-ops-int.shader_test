probe rtv-0 (0, 0) f32(0.25, 0.5, 0.75, 1.0)
probe rtv-0 (1, 0) f32(0.0, 1.0, 0.0, 1.0)
probe rtv-0 (0, 1) f32(0.0, 1.0, 0.0, 1.0)
probe rtv-0 (1, 1) f32(0.0, 1.0, 0.0, 1.0)
probe uav-1 (1) i32(3, 5, -1, 2)
probe uav-1 (2) i32(3, 5, -1, 2)
