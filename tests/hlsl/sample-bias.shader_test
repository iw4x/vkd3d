[compute-shader]
sampler s;
Texture2D<float4> t;
RWTexture2D<float4> u;
uniform float bias;

    [numthreads(2, 2, 1)]
void main(uint3 id : SV_DispatchThreadID)
{
    float2 pos = (id.xy + 0.5) / 2.0;
    u[id.xy] = t.SampleBias(s, pos, bias);
}

