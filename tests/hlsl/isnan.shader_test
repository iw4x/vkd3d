if(sm>=6) probe (0, 0) f32(0.0, 0.0, 10.0, 10.0)

[pixel-shader]
float4 b;

float4 main() : sv_target
{
    float4 c = 0.0 / b; // Simplified to 0.0, even though b could be 0.0.

    return 10 * isnan(c) + (c != c);
}

