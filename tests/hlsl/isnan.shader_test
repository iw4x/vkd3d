% Loads with relative addressing are not simplified.
[pixel-shader]
unsigned int i;

float4 main() : sv_target
{
    float a[3] = {1.0, 2.0, 3.0};

    return 10 * isnan(a[i]) + (a[i] != a[i]); // Not simplified in SM4, but a[i] can't be NaN.
}

[test]
if(sm<4) write cbv-f32 (0) f32(2.0)
if(sm>=4) write cbv-0 (0) i32(2)
draw quad
probe (0, 0) f32(0.0, 0.0, 0.0, 0.0)

[pixel-shader fail(sm<4)]
unsigned int i;

float4 main() : sv_target
{
    float a[3] = {1.0, 2.0, 0.0 / 0.0};

    return 10 * isnan(a[i]) + (a[i] != a[i]); // Not simplified in SM4.
}

[test]
write cbv-0 (0) i32(2)
draw quad
if(sm<4) probe (0, 0) f32(0.0, 0.0, 0.0, 0.0)
if(sm>=4 & sm<6) todo(mvk<1.4.0 | msl) probe (0, 0) f32(11.0, 11.0, 11.0, 11.0)
if(sm>=6) probe (0, 0) f32(10.0, 10.0, 10.0, 10.0)
write cbv-0 (0) i32(1)
draw quad
probe (0, 0) f32(0.0, 0.0, 0.0, 0.0)

% isnan() on an indirectly addressed uniform array fails with an internal
% compiler error in shader model 4/5 on fxc/d3dcompiler.
[pixel-shader fail(sm>=4 & sm<6) todo(sm>=4 & sm<6)]
float a[3];
unsigned int i;

float4 main() : sv_target
{
    return isnan(a[i]);
}

% A temp load (that can't be copy-propagated) is assumed to never be NaN.
[pixel-shader todo(sm<3)]
float a[4];
float aa, bb;
float k;

float4 main() : sv_target
{
    float tmp = aa / bb;

    for (int i = 0; i < k; i++)
       tmp += a[i];
    return 10 * isnan(tmp) + (tmp != tmp);
}

