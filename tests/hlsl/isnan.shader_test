if(sm>=6) probe (0, 0) f32(0.0, 10.0, 11.0, 11.0)

[pixel-shader]
float4 a, b;

float4 main() : sv_target
{
    float4 c = a / b;
    float4 d = sin(c);

    return 10 * isnan(d) + (d != d); // Not simplified in SM4.
}

[test]
write cbv-0 (0) f32(0.0, -0.0, 1.0, -1.0)
write cbv-0 (4) f32(1.0, 0.0, 0.0, 0.0)
draw quad
if(sm<4) todo(mesa<26 & radv) probe (0, 0) f32(0.0, 0.0, 0.0, 0.0)
if(sm>=4 & sm<6) todo(mvk<1.4.0 | msl) probe (0, 0) f32(0.0, 11.0, 11.0, 11.0)
if(sm>=6) bug(mvk) probe (0, 0) f32(0.0, 10.0, 10.0, 10.0)
% ^ We get f32(0, 0, 0, 0) in mvk.

% It is not expected for trigonometry functions to result in NaN, despite the
% possibility of having an inf argument.
[pixel-shader]
float4 a;

float4 main() : sv_target
{
    float4 c = sin(1.0 / a);

    return 10 * isnan(c) + (c != c); // Simplified to false.
}

[test]
write cbv-0 (0) f32(0.0, -0.0, 1.0, -1.0)
draw quad
if(sm<6) todo(mesa<26 & radv | sm>=4 & !mvk<1.4.0 & !msl) probe (0, 0) f32(0.0, 0.0, 0.0, 0.0)
if(sm>=6) bug(mvk) probe (0, 0) f32(10.0, 10.0, 0.0, 0.0)
% ^ We get f32(0, 0, 0, 0) in mvk.

[pixel-shader]
float4 a, b;

float4 main() : sv_target
{
    float4 a1 = 1.0 / a;
    float4 b1 = 1.0 / b;
    float4 c = a1 + b1; // Could be (inf) + (-inf)

    return 10 * isnan(c) + (c != c); // Not simplified in SM4.
}

