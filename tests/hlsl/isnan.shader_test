% It seems that for shader model 4 fxc/d3dcompiler flags expressions that can
% be NaN or not and propagates this accordingly. This seems closely tied to
% whether an (x != x) expression is simplified or not, since isnan(x) is
% lowered to that. One way to test this flagging is by adding an (x == x) or
% (x != x) comparison of the expression with itself and seeing if it is
% simplified as true/false or not.
% Without IEEE strictness, shader model 2-3 seems to always simplify both
% isnan() and (x != x) to false. Shader model 6 never simplifies isnan(),
% unless the argument is a compile-time constant, but it does simplify
% (x == x) and (x != x) to true/false.

% In shader model <6 uniform loads are assumed to never be NaN, unless precise
% is used in shader model 4+.
[pixel-shader]
float4 a;

float4 main() : sv_target
{
    return 10 * isnan(a) + (a != a); // both simplified to false.
}

[test]
write cbv-0 (0) f32(inf, nan, 1.0, 0.0)
draw quad
if(sm<6) todo(mesa<26 & radv | sm>=4 & !mvk<1.4.0 & !msl) probe (0, 0) f32(0.0, 0.0, 0.0, 0.0)
if(sm>=6) probe (0, 0) f32(0.0, 10.0, 0.0, 0.0)

[pixel-shader]
float4 a;

float4 main() : sv_target
{
    // isnan() is not simplified for SM>=4, and (a != a) is not simplified for any SM.
    precise float4 ret = 10 * isnan(a) + (a != a);
    return ret;
}

[test]
write cbv-0 (0) f32(inf, nan, 1.0, 0.0)
todo(msl & sm>=6) draw quad
% inf != inf for SM < 4.
if(sm<4) todo(mesa>=26 | !radv) winbug(nvidia) probe (0, 0) f32(1.0, 1.0, 0.0, 0.0)
if(sm>=4) todo(sm<6 & (mvk<1.4.0 | msl)) probe (0, 0) f32(0.0, 11.0, 0.0, 0.0)

[pixel-shader]
float4 a, b;

float4 main() : sv_target
{
    float4 c = a / b;

    return 10 * isnan(c) + (c != c); // Not simplified in SM4.
}

[test]
write cbv-0 (0) f32(1.0, 1.0, -0.0, -0.0)
write cbv-0 (4) f32(0.0, -0.0, 0.0, -0.0)
draw quad
if(sm<4) todo(mesa<26 & radv) probe (0, 0) f32(0.0, 0.0, 0.0, 0.0)
if(sm>=4 & sm<6) todo(mvk<1.4.0 | msl) probe (0, 0) f32(0.0, 0.0, 11.0, 11.0)
if(sm>=6) probe (0, 0) f32(0.0, 0.0, 10.0, 10.0)
write cbv-0 (0) f32(inf, nan, 1.0, 0.0)
write cbv-0 (4) f32(inf, 1.0, nan, 1.0)
draw quad
if(sm<4) todo(mesa<26 & radv) probe (0, 0) f32(0.0, 0.0, 0.0, 0.0)
if(sm>=4 & sm<6) todo(mvk<1.4.0 | msl) probe (0, 0) f32(11.0, 11.0, 11.0, 0.0)
if(sm>=6) probe (0, 0) f32(10.0, 10.0, 10.0, 0.0)

[pixel-shader]
float4 b;

float4 main() : sv_target
{
    float4 c = 1.0 / b;

    return 10 * isnan(c) + (c != c); // Simplified to false.
}

