[compute-shader]
RWTexture2D<uint> u0;
RWTexture2D<uint4> u1;

    [numthreads(3, 4, 1)]
void main(uint3 id : SV_DispatchThreadID)
{
    uint x = u0[id.xy];
    u1[id.xy] = float4(x, QuadReadAcrossX(x), QuadReadAcrossY(x), QuadReadAcrossDiagonal(x));
}

