% These tests do not need derivatives and compile fine even without that capability.
% However, assembling square quads pretty much makes sense only for computing
% derivatives, so drivers that do not support derivatives in amplification and
% mesh shaders (which is, at the time of writing, everything except WARP) do not
% necessarily use square quads either, even at SM >= 6.6.
[require]
shader model >= 6.5
mesh-shader
derivatives-in-mesh-shaders

[mesh-shader]
struct vertex_out
{
    float4 position : SV_Position;
};

RWTexture2D<uint4> u1 : register(u1);

    [outputtopology("triangle")]
    [numthreads(1, 1, 1)]
void main(out vertices vertex_out verts[1], uint3 id : SV_DispatchThreadID)
{
    u1[id.xy] = float4(WaveGetLaneIndex() % 4, 0, 0, 0);

    SetMeshOutputCounts(1, 0);

    verts[0].position = float4(-1.0, -1.0, 0.0, 1.0);
}

[pixel-shader]
float4 main() : SV_Target
{
    return float4(0.0, 1.0, 0.0, 1.0);
}

