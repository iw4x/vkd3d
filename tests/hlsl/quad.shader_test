[amplification-shader]
struct payload_data
{
    uint x;
};

RWTexture2D<uint4> u1 : register(u1);

groupshared struct payload_data p;

    [numthreads(1, 1, 1)]
void main(uint3 id : SV_DispatchThreadID) {
    u1[id.xy] = float4(WaveGetLaneIndex() % 4, 0, 0, 0);

    DispatchMesh(1, 1, 1, p);
}

[mesh-shader]
struct payload_data
{
    uint x;
};

struct vertex_out
{
    float4 position : SV_Position;
};

    [outputtopology("triangle")]
    [numthreads(1, 1, 1)]
void main(in payload payload_data p, out vertices vertex_out verts[1])
{
    SetMeshOutputCounts(1, 0);

    verts[0].position = float4(-1.0, -1.0, 0.0, 1.0);
}

