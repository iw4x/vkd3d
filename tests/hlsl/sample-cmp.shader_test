[require]
shader model >= 4.0

[sampler-0]
filter linear linear linear
address clamp clamp clamp
comparison never

[srv-0]
format r32-float-shadow
size (2d, 2, 2)
0.5     0.5
0.5     0.5

[pixel shader]
Texture2D<float> t : register(t0);
SamplerComparisonState s : register(s0);

float4 main() : sv_target
{
    float ref = 0.5, delta = 0.00000007;
    return float4(
        t.SampleCmpLevelZero(s, float2(0.5, 0.5), ref - delta),
        t.SampleCmpLevelZero(s, float2(0.5, 0.5), ref),
        t.SampleCmpLevelZero(s, float2(0.5, 0.5), ref + delta),
        1.0);
}

[test]
draw quad
probe (0, 0) f32(0.0, 0.0, 0.0, 1.0)

[sampler-0]
filter linear linear linear
address clamp clamp clamp
comparison less

[test]
draw quad
probe (0, 0) f32(1.0, 0.0, 0.0, 1.0)

[sampler-0]
filter linear linear linear
address clamp clamp clamp
comparison equal

[test]
draw quad
probe (0, 0) f32(0.0, 1.0, 0.0, 1.0)

[sampler-0]
filter linear linear linear
address clamp clamp clamp
comparison less equal

[test]
draw quad
probe (0, 0) f32(1.0, 1.0, 0.0, 1.0)

[sampler-0]
filter linear linear linear
address clamp clamp clamp
comparison greater

[test]
draw quad
probe (0, 0) f32(0.0, 0.0, 1.0, 1.0)

[sampler-0]
filter linear linear linear
address clamp clamp clamp
comparison not equal

[test]
draw quad
probe (0, 0) f32(1.0, 0.0, 1.0, 1.0)

[sampler-0]
filter linear linear linear
address clamp clamp clamp
comparison greater equal

[test]
draw quad
probe (0, 0) f32(0.0, 1.0, 1.0, 1.0)

[sampler-0]
filter linear linear linear
address clamp clamp clamp
comparison always

[test]
draw quad
probe (0, 0) f32(1.0, 1.0, 1.0, 1.0)

[sampler-0]
filter linear linear linear
address clamp clamp clamp
comparison greater

% Non-constant ref.
[pixel-shader]
Texture2D<float> t : register(t0);
SamplerComparisonState s : register(s0);

float ref, delta;

float4 main() : sv_target
{
    return float4(
        t.SampleCmpLevelZero(s, float2(0.5, 0.5), ref - delta),
        t.SampleCmpLevelZero(s, float2(0.5, 0.5), ref),
        t.SampleCmpLevelZero(s, float2(0.5, 0.5), ref + delta),
        1.0);
}

[test]
write cbv-0 (0) f32(0.5, 0.00000007)
draw quad
probe (0, 0) f32(0.0, 0.0, 1.0, 1.0)

[pixel-shader]
Texture2D<float> t : register(t0);
SamplerComparisonState s : register(s0);

float ref;

float4 main() : sv_target
{
    float delta = 0.00000007;
    return float4(
        t.SampleCmp(s, float2(0.5, 0.5), ref - delta),
        t.SampleCmp(s, float2(0.5, 0.5), 0.5),
        t.SampleCmp(s, float2(0.5, 0.5), ref + delta),
        1.0);
}

[test]
write cbv-0 (0) f32(0.5)
draw quad
probe (0, 0) f32(0.0, 0.0, 1.0, 1.0)

% Implicit derivatives in compute shaders.
[require]
shader model >= 6.6

[uav-0]
format r32g32b32a32-float
size (2d, 4, 4)

[srv-0]
format r32-float-shadow
size (2d, 4, 4)
levels 3

2.0 3.0 4.0 5.0
4.0 1.0 5.0 5.0
2.0 7.0 7.0 7.0
8.0 7.0 7.0 7.0

20.0 30.0
40.0 10.0

100.0

[compute-shader]
SamplerComparisonState s;
Texture2D<float> t;
RWTexture2D<float4> u;

    [numthreads(4, 4, 1)]
void main(uint3 id : SV_DispatchThreadID)
{
    float2 pos = (id.xy + 0.5) / 4.0;
    u[id.xy] = float4(t.SampleCmp(s, pos, 1.5), t.SampleCmp(s, pos, 3.5),
            t.SampleCmp(s, pos, 5.5), t.SampleCmp(s, pos, 7.5));
}

[test]
write cbv-0 (0) f32(0.0)
todo dispatch 1 1 1
probe uav-0 (0, 0) f32(0.0, 1.0, 1.0, 1.0)
probe uav-0 (1, 1) f32(1.0, 1.0, 1.0, 1.0)
probe uav-0 (2, 3) f32(0.0, 0.0, 0.0, 1.0)

[compute-shader]
SamplerComparisonState s;
Texture2D<float> t;
RWTexture2D<float4> u;

    [numthreads(2, 2, 1)]
void main(uint3 id : SV_DispatchThreadID)
{
    float2 pos = (id.xy + 0.5) / 2.0;
    u[id.xy] = float4(t.SampleCmp(s, pos, 15.0), t.SampleCmp(s, pos, 25.0),
            t.SampleCmp(s, pos, 35.0), t.SampleCmp(s, pos, 45.0));
}

[test]
