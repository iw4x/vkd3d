[require]
shader model >= 4.0
% DXC segfaults when compiling an unused mip slice.
shader model < 6.0

[pixel-shader fail]
Texture2DArray<int2> t : register(t0);

float4 main() : sv_target
{
    t.mips[0];
    return float4(t.mips[1][uint3(0, 0, 0)], 0, 0);
}

% UAVs don't support the mips operator.
[require]
shader model >= 5.0

[pixel-shader fail]
RWTexture2D<float4> t;

float4 main() : sv_target
{
    return t.mips[0][uint2(0, 0)];
}
