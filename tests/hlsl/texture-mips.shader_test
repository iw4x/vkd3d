% SM6 accepts single-component vectors for the mip argument.
[pixel-shader fail(sm<6)]
Texture2D t;

float4 main() : sv_target
{
    return t.mips[int1(1)][int2(0, 0)];
}

[pixel-shader todo(sm<6)]
Texture1D<float> a;
Texture1DArray<float> b;

float4 main() : sv_target
{
    return float4(a.mips[3][11], b.mips[3][int2(11, 22)], 0, 0);
}

[pixel-shader fail(sm<6)]
