[srv-0]
format r32g32-sint
size (2darray, 2, 2, 2)
levels 2

10 11    12 13
14 15    16 17
20 21    22 23
24 25    26 27

30 31
40 41

[srv-1]
format r32-uint
size (3d, 2, 2, 4)
levels 2

60 61    62 63
64 65    66 67
70 71    72 73
74 75    76 77

80 81

[pixel-shader todo(sm<6)]
Texture2DArray<int2> a : register(t0);
Texture3D<uint> b : register(t1);
uniform uint level;
uniform uint3 pos;

float4 main() : sv_target
{
    return float4(a.mips[level][pos], b.mips[level][pos], 0);
}

