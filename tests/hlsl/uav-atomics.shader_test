[uav-1]
format r32-uint
size (buffer, 6)

0xffffffff 5 0xffffffff 5 5 5

[uav-2]
format r32-sint
size (buffer, 6)

-3 1 -3 1 1 1

% For InterlockedMax/Min, values other than uint are cast to int first.
% The operation itself is signed (imax/imin) only if the destination type is
% int and, for SM < 6, the value type (after any casting) is int as well.

[compute-shader fail(sm<5)]
RWBuffer<uint> u : register(u1);
RWBuffer<int> s : register(u2);

uniform float2 f;
uniform bool b;
uniform uint n;
uniform int i;

    [numthreads(1, 1, 1)]
void main()
{
    InterlockedMax(u[0], f.x);
    InterlockedMin(u[1], f.y);
    InterlockedMin(u[2], b);
    InterlockedMax(u[3], n);
    InterlockedMin(u[4], n);
    InterlockedMax(u[5], i);

    InterlockedMax(s[0], f.x);
    InterlockedMin(s[1], f.y);
    InterlockedMin(s[2], b);
    InterlockedMax(s[3], n);
    InterlockedMin(s[4], n);
    InterlockedMax(s[5], i);
}

