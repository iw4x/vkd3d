[uav-1]
stride 4
size (buffer, 5)

2.0 2.0 0.0 0.0 0.0

[uav-2]
format r32-uint
size (buffer, 8)

0x40000000 0x80000000 0xc0000000 0x40000000 0x40800000 0 0 0

[uav-3]
format r32-sint
size (buffer, 3)

-2 0 0

% For SM < 6, InterlockedExchange() swaps bits. A new value, other than int or
% uint, is cast to float first before swapping. For an out argument, other than
% int or uint, the original bits are interpreted as float first, and then cast
% to the out argument type. For int or uint values, the bits are used as is.
%
% For SM6, the new value is cast to the destination type, and the old value to
% the out argument type.

[compute-shader fail(sm<5) todo(sm>=5)]
RWStructuredBuffer<float> f : register(u1);
RWBuffer<uint> u : register(u2);
RWBuffer<int> s : register(u3);

    [numthreads(1, 1, 1)]
void main()
{
    float x, y;
    int i, j;
    bool b;
    min16int mi;
    min16uint mu;
    half h;

    InterlockedExchange(f[0], asuint(4.0), x);
    InterlockedExchange(f[1], asint(3.0), i);
    InterlockedExchange(u[0], 1.5, y);
    InterlockedExchange(u[1], true, b);
    InterlockedExchange(u[2], (min16int)3, mi);
    InterlockedExchange(u[3], (min16uint)3, mu);
    InterlockedExchange(u[4], (half)3.0, h);
    InterlockedExchange(s[0], 1.5, j);
    f[2] = x;
    f[3] = y;
    f[4] = h;
    u[5] = b;
    u[6] = mi;
    u[7] = mu;
    s[1] = i;
    s[2] = j;
}

