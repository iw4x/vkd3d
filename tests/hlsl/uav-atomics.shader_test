% Interlocked* functions return void.

[compute-shader fail]
RWBuffer<uint> u : register(u1);

    [numthreads(3, 1, 1)]
void main()
{
    uint err = InterlockedAdd(u[0], 1);
}

[compute-shader fail]
RWBuffer<uint> u : register(u1);

    [numthreads(3, 1, 1)]
void main()
{
    uint old;
    uint err = InterlockedAdd(u[0], 1, old);
}

[compute-shader fail]
RWBuffer<uint> u : register(u1);

    [numthreads(3, 1, 1)]
void main()
{
    uint err = InterlockedCompareStore(u[0], 0, 1);
}

[compute-shader fail]
RWBuffer<uint> u : register(u1);

    [numthreads(3, 1, 1)]
void main()
{
    uint old;
    uint err = InterlockedCompareExchange(u[0], 0, 1, old);
}

% The underlying type of the destination parameter must be a scalar integer,
% other than InterlockedExchange().

[compute-shader fail]
RWBuffer<uint1> u : register(u1);

    [numthreads(3, 1, 1)]
void main()
{
    InterlockedAdd(u[0], 1);
}

[compute-shader fail]
RWBuffer<int1> u : register(u1);

    [numthreads(3, 1, 1)]
void main()
{
    InterlockedAdd(u[0], 1);
}

[compute-shader fail]
RWBuffer<float> u : register(u1);

    [numthreads(3, 1, 1)]
void main()
{
    InterlockedAdd(u[0], 1);
}

[compute-shader fail todo(sm>=5)]
RWBuffer<min16int> u : register(u1);

    [numthreads(3, 1, 1)]
void main()
{
    InterlockedAdd(u[0], 1);
}

% InterlockedExchange() allows float and half UAV destinations, but not double.
% For SM6, half destinations are not allowed either.

[compute-shader fail(sm<5) todo(sm>=5)]
RWBuffer<float> u : register(u1);

    [numthreads(3, 1, 1)]
void main()
{
    float x;
    InterlockedExchange(u[0], (float)1.0, x);
}

[compute-shader fail(sm<5 | sm>=6) todo(sm>=5)]
RWBuffer<half> u : register(u1);

    [numthreads(3, 1, 1)]
void main()
{
    half x;
    InterlockedExchange(u[0], (half)1.0, x);
}

[compute-shader fail]
RWBuffer<double> u : register(u1);

    [numthreads(3, 1, 1)]
void main()
{
    double x;
    InterlockedExchange(u[0], (double)1.0, x);
}

% Non-structured UAV targets must have scalar type.

[compute-shader fail]
RWBuffer<int4> u : register(u1);

     [numthreads(3, 1, 1)]
void main()
{
    InterlockedAdd(u[0].x, 1);
}

% Interlocked operations on structured UAVs.

[uav-1]
stride 16
size (buffer, 2)
0 0 0 0
0 0 0 0

[compute-shader fail(sm<5)]
struct apple
{
    int2 a, b;
};

RWStructuredBuffer<apple> u : register(u1);

uniform int4 i;

    [numthreads(3, 1, 1)]
void main(uint local_idx: SV_groupIndex, uint group_id : SV_GroupID)
{
    InterlockedAdd(u[group_id.x].a.x, i.x * local_idx + group_id.x * 10);
    InterlockedAdd(u[group_id.x].a.y, i.y * local_idx + group_id.x * 10);
    InterlockedAdd(u[group_id.x].b.x, i.z * local_idx + group_id.x * 10);
    InterlockedAdd(u[group_id.x].b.y, i.w * local_idx + group_id.x * 10);
}

