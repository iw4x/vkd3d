[pixel shader]
float cond;

float4 main() : sv_target
{
    float4 a = {1, 2, 3, 4};
    float4 b;

    // invalidate a
    if (cond)
        a = float4(-1, -2, -3, -4);

    b = a;
    a.y = 357;
    return b.y;
}

[test]
write cbv-0 (0) f32(0.0)
draw quad
probe (0, 0) f32(2.0, 2.0, 2.0, 2.0)
write cbv-0 (0) f32(1.0)
draw quad
probe (0, 0) f32(-2.0, -2.0, -2.0, -2.0)

[pixel-shader]
float cond;

float4 main() : sv_target
{
    float2 r = {1, 2};
    float2 tmp;

    // invalidate r
    if (cond)
        r = float2(10, 20);

    tmp = r;
    r = tmp;
    return r.y;
}

