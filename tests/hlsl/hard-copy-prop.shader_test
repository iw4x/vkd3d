% Write to the source between a load and a later swizzle of the load.
[pixel-shader fail(sm<4) todo(sm<4)]
uint i;

float4 main() : sv_target
{
    float x[2] = {0, 0};
    x[i] = 1;
    float2 a[2] = {{x[0], 0}, {x[1], 0}};

    float2 r = a[i];
    x[i] = 5;

    return float4(r.x, x[0], x[1], 0);
}

