[pixel-shader fail(sm<4) todo(sm<4)]
float x[2][2];
uint i;

float4 main() : sv_target
{
    float a[2][2] = x;
    a[i][i]++;

    a[0][0] = a[0][0];
    float t = a[0][1];
    a[0][1] = a[1][0];
    a[1][0] = t;

    return a[i][0];
}

