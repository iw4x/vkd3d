write cbv-0 (0) u32(1)
draw quad
probe (0, 0) f32(1.0, 0.0, 5.0, 0.0)

% Copy-prop of non-constant derefs must not create a load from a variable that
% has been written since the propagated value was read.

[pixel-shader fail(sm<4) todo(sm<4)]
float x[2];
uint i;

float4 main() : sv_target
{
    float a[2] = x;
    a[i]++;
    a = a;
    return a[i];
}

