[pixel-shader fail(sm<4) todo(sm<4)]
float x[2], y[2];
uint i;

float4 main() : sv_target
{
    float a[2] = x;
    float b[2] = y;
    a[i]++;
    b[i]++;

    float t[2] = a;
    a = b;
    b = t;

    return a[i];
}

