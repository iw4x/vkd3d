% OOB indexes are illegal, but sm < 6 allows them in dead code.
% We need copy-prop to know if the code is dead.
% This means copy-prop needs to be able to handle OOB indexes.
[pixel-shader fail(sm>=6)]
float4 main() : sv_target
{
    static float4 arr[4];
    bool x = false;

    if (x)
    {
        arr[100] = 0;
        return arr[100];
    }

    return 0;
}

[pixel shader]
float a;

float4 main() : sv_target
{
    float arr[2][2] = {1, 2, 3, 4};

    if (a > 0)
        arr[1][1] = 5;

    return float4(arr[0][0], arr[0][1], arr[1][0], arr[1][1]);
}

[test]
write cbv-0 (0) f32(11.0)
draw quad
probe (0, 0) f32(1, 2, 3, 5)

% Copy-prop should not propagate a non-constant index into a vector,
% as the latter may be lowered to a dot product, which reads the other
% components such as inf or nan.

[pixel-shader]
float4 v;
uint i;

float4 main() : sv_target
{
    float a[2] = {v[0], v[1]};
    return a[i];
}

