[pixel-shader fail(sm<4) todo(sm<4)]
float x[2];
uint i;

float4 main() : sv_target
{
    float a[2] = x;
    a[i]++;

    float t = a[0];
    a[0] = a[1];
    a[1] = t;

    return a[i];
}

