write cbv-0 (5) u32(1)
draw quad
probe (0, 0) f32(6.0, 6.0, 6.0, 6.0)

% Calling f(inout b) twice creates a self-copy for b after folding.
[pixel-shader fail(sm<4) todo(sm<4)]
float x[2];
uint i;

void f(inout float b[2])
{
    b[i]++;
}

float4 main() : sv_target
{
    float a[2] = x;
    f(a);
    f(a);
    return a[i];
}

