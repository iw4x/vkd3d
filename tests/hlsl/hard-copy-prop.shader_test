[pixel-shader]
float x[4];
uint4 i;

float4 main() : sv_target
{
    float y[2][2];

    y[0][0] = x[0 + 2*0];
    y[0][1] = x[0 + 2*1];
    y[1][0] = x[1 + 2*0];
    y[1][1] = x[1 + 2*1];

    return y[i.x][i.y];
}

