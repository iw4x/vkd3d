[pixel-shader]
float cond;

float4 main() : sv_target
{
    float2 r = {3, 4};

    // invalidate r
    if (cond)
        r = float2(30, 40);

    r = r;
    r = float2(1, r.y);

    return float4(r, 0, 0);
}

[test]
write cbv-0 (0) f32(0.0)
draw quad
probe (0, 0) f32(1.0, 4.0, 0.0, 0.0)
write cbv-0 (0) f32(1.0)
draw quad
probe (0, 0) f32(1.0, 40.0, 0.0, 0.0)

[pixel-shader]
float x[6];
float y[3];
uint4 i;

float4 main() : sv_target
{
    float4 r;
    float z[3][2];

    z[0][0] = x[0];
    z[1][0] = x[1];
    z[2][0] = x[2];
    z[0][1] = x[1];
    z[1][1] = x[3];
    z[2][1] = x[5];

    r.x = z[i.x][0];
    r.y = z[i.y][1];

    z[0][1] = y[2];
    z[1][1] = y[1];
    z[2][1] = y[0];

    r.z = z[i.z][1];

    z[2][0] = x[1];
    z[2][1] = x[5];

    r.w = z[2][i.w];

    return r;
}

