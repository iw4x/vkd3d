[require]
shader model >= 5.0

[uav-0]
stride 4
size (buffer, 2)

0 0

[compute-shader todo(sm<6)]
namespace A
{
    groupshared uint x;
}

namespace B
{
    groupshared uint x;
}

RWStructuredBuffer<uint> u : register(u0);

    [numthreads(2, 1, 1)]
void main(uint i : SV_GroupIndex)
{
    if (i == 0)
        A::x = 1;
    else
        B::x = 2;
    GroupMemoryBarrierWithGroupSync();
    u[i] = i == 0 ? B::x : A::x;
}

