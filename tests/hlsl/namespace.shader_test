[pixel-shader todo(sm<6)]
static const float S = 4;

namespace A
{
    namespace B
    {
        typedef float T;

        struct S
        {
            T x;
        };
    }
}

namespace A
{
    static const B::T x = 1;

    struct U
    {
        B::S s;
        B::T y;
    };
}

float4 main() : sv_target
{
    A::B::T y = 2;
    A::U s;
    s.s.x = 3;
    s.y = S;

    return float4(A::x, y, s.s.x, s.y);
}

