[pixel-shader todo]
namespace A
{
    namespace B
    {
        static const int x = 2;
        static float y[x];
    }
}

namespace A
{
    static float z = B::x;
}

float4 main() : sv_target
{
    A::B::y[0] = 1;
    A::B::y[1] = 2;
    ++A::z;
    return float4(A::B::y[0], A::B::y[1], A::z, A::B::x);
}

