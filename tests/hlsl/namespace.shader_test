[pixel-shader]
namespace A
{
}

namespace B
{
    namespace C
    {
        namespace D
        {
        }
    }
}

// Reopening namespaces.
namespace B
{
    namespace C
    {
    }
}

float4 main() : sv_target
{
    return 0;
}

[pixel-shader fail todo(sm<6)]
namespace A
{
    float4 main() : sv_target
    {
        return 0;
    }
}

% Namespace names can use reserved names.
[pixel-shader]
namespace sin
{
}

float4 main() : sv_target
{
    return 1;
}

% The namespace sin shadows the sin() intrinsic.
[pixel-shader fail]
namespace sin
{
}

float4 main() : sv_target
{
    return sin(1);
}

% Qualified identifier resolution takes the first possible match.
[pixel-shader fail todo(sm<6)]
namespace A
{
    static const float x = 1;
}

namespace B
{
    namespace A
    {
        namespace x
        {
        }
    }

    static const float y = A::x;
}

float4 main() : sv_target
{
    return B::y;
}

[pixel-shader fail todo(sm<6)]
namespace A
{
    static const float x = 1;
}

float4 main() : sv_target
{
    return A::::x;
}

[pixel-shader fail todo(sm<6)]
namespace A
{
    static const float x = 1;
}

float4 main() : sv_target
{
    return A::1;
}

[pixel-shader todo]
namespace A
{
    static const int x = 3;
    static const float y[x] = {4, 5, 6};
}

float4 main() : sv_target
{
