{
}

float A::f()
{
    return 1;
}

namespace A
{
    float f();
}

float4 main() : sv_target
{
    return A::f();
}

% A declaration inside a namespace prevent lookup with the same name in upper scopes.

[pixel-shader fail todo(sm<6)]
float f(float x, float y)
{
    return 1;
}

namespace A
{
    float f(float x)
    {
        return 2;
    }

    namespace B
    {
        float g()
        {
            return f(1, 2);
        }
    }
}

float4 main() : sv_target
{
    return A::B::g();
}

