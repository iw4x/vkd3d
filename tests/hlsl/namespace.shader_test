% Qualified prototype redcleration is not allowed for SM < 6.
[pixel-shader fail(sm<6) todo(sm<6)]
namespace A
{
    namespace B
    {
        float f();
    }
}

float A::B::f();

float A::B::f()
{
    return 1;
}

float4 main() : sv_target
{
    return A::B::f();
}

