% SM < 6 allocates cbuffers grouped by namespace; SM6 uses declaration order instead.
% The members are read through functions in their namespaces, since SM6 places them in the global namespace.
[pixel-shader todo(sm<6)]
namespace A
{
    cbuffer C  // b1
    {
        float a;
    };

    float f()
    {
        return a;
    }
}

namespace B
{
    cbuffer C  // b3
    {
        float b;
    };

    float g()
    {
        return b;
    }
}

float y;       // b0

namespace A
{
    cbuffer D  // b2
    {
        float c;
    };

    float h()
    {
        return c;
    }
}

float4 main() : sv_target
{
    return float4(A::f(), A::h(), B::g(), y);
}

