% Intrinsics can't be accessed via the global '::' scope operator.
[pixel-shader fail todo(sm<6)]
namespace A
{
    float f()
    {
        return ::sin(0);
    }
}

float4 main() : sv_target
{
    return A::f();
}

% SM < 6 allocates uniforms grouped by namespace; SM6 uses declaration order instead.
[pixel-shader todo]
float x;

namespace A
{
    float y;
}

namespace B
{
    float z;
}

float u;

namespace A
{
    float v;
}

float4 main() : sv_target
{
    return float4(x, A::y + A::v, B::z, u);
}

