[require]
shader model >= 4.0

% For SM < 6, constant buffer members are placed in the containing namespace;
% for SM6, they are placed in the global namespace.
[pixel-shader todo fail(sm>=6)]
namespace A
{
    cbuffer C : register(b0)
    {
        float x : packoffset(c0.y);
    };

    float f()
    {
        return x;
    }

    namespace B
    {
        cbuffer D : register(b2)
        {
            float2 z : packoffset(c1.z);
        };
    }
}

namespace A
{
    cbuffer C : register(b1)
    {
        float y : packoffset(c2.x);
    };

    float g()
    {
        return y;
    }
}

float4 main() : sv_target
{
    return float4(A::f(), A::g(), ::A::B::z);
}

