[require]
shader model >= 6.0
int64

[pixel-shader]
uniform uint64_t2 l;
uniform uint2 u;

float4 main() : sv_target
{
    uint64_t2 n = l / u;
    uint4 result = uint4(l.x, l.y, n.x, n.y);
    return result;
}

[test]
write cbv-0 (0) u64(0x500000001, 0x100000002)
write cbv-0 (4) u32(10, 4, 0, 0)
draw quad
probe (0, 0) f32(1.0, 2.0, 2147483648.0, 1073741824.0)

[pixel-shader]
uniform int64_t2 l;
uniform int2 i;

float4 main() : sv_target
{
    int64_t2 n = l / i;
    int4 result = int4(l.x, l.y, n.x, n.y);
    return result;
}

