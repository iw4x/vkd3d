[test]
write cbv-0 (0) u16(0x22, 0xff00)
draw quad
% On Windows AMD the second component is (double)0xff00, which is correct, but
% the first component is (double)0xff000022, which is not correct: the upper
% word wasn't masked out, apparently.
winbug(amd) probe (0, 0) f64(34, 65280)

[pixel shader]
uniform int16_t2 u;

uint4 main() : sv_target
{
    uint4 ret;
    double2 d = double2(u);
    asuint(d.x, ret.x, ret.y);
    asuint(d.y, ret.z, ret.w);
    return ret;
}

