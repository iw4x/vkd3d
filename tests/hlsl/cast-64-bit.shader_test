size (2d, 64, 64)

[require]
shader model >= 5.0
float64

[pixel shader todo]
uniform double2 d;

int4 main() : sv_target
{
    min16int4 s = min16int4(d, d);
    return s * min16int4(2, 2, 1, 1);
}

