[rtv-0]
format r32g32b32a32-uint
size (2d, 64, 64)

[pixel-shader]
uint4 main(float4 p : sv_position) : sv_target
{
    int64_t2 r;

    r = floor(p.xy / 4) - 8;
    r <<= 31;

    return uint4(r.x & 0xffffffff, r.x >> 32, r.y & 0xffffffff, r.y >> 32);
}

[test]
draw quad
probe ( 2,  6) u64(0xfffffffc00000000, 0xfffffffc80000000)
probe (10, 14) u64(0xfffffffd00000000, 0xfffffffd80000000)
