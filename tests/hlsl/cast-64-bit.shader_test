probe (26, 30) u64(0xffffffff00000000, 0xffffffff80000000)
probe (34, 38) u64(0x0000000000000000, 0x0000000080000000)
probe (42, 46) u64(0x0000000100000000, 0x0000000180000000)
probe (50, 54) u64(0x0000000200000000, 0x0000000280000000)
probe (58, 62) u64(0x0000000300000000, 0x0000000380000000)

[pixel-shader]
uint4 main(float4 p : sv_position) : sv_target
{
    uint64_t2 r;

    r = floor(p.xy / 4) - 8;
    r <<= 31;

    return uint4(r.x & 0xffffffff, r.x >> 32, r.y & 0xffffffff, r.y >> 32);
}

