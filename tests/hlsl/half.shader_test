% While half scalar and half vector globals are not allowed without the
% backwards compatibility flag, halfs in arrays or structs are allowed.
[pixel-shader]
struct apple
{
    float a;
    half h;
} ap;

half b[4];

float4 main() : sv_target
{
    return float4(b[0], b[1], ap.h, b[3]);
}

[test]
if(sm>=4) write cbv-0  (0) f32(1.0, 2.0, 0.0, 0.0)
if(sm>=4) write cbv-0  (4) f32(3.0)
if(sm>=4) write cbv-0  (8) f32(4.0)
if(sm>=4) write cbv-0 (12) f32(5.0)
if(sm>=4) write cbv-0 (16) f32(6.0)
if(sm<4) write cbv-f32  (0) f32(3.0)
if(sm<4) write cbv-f32  (4) f32(4.0)
if(sm<4) write cbv-f32  (8) f32(5.0)
if(sm<4) write cbv-f32 (12) f32(6.0)
if(sm<4) write cbv-f32 (16) f32(1.0)
if(sm<4) write cbv-f32 (20) f32(2.0)
draw quad
probe (0, 0) f32(3.0, 4.0, 2.0, 6.0)

[pixel shader]
float4 var;

float4 main() : sv_target
{
    half4 ret = var + 0.5;
    return ret;
}

[test]
uniform 0 float4 1.0 2.0 3.0 4.0
draw quad
probe (0, 0) f32(1.5, 2.5, 3.5, 4.5)

