[vertex-shader]
void main(half4 pos : POSITION, out half4 out_pos : SV_POSITION, out float4 tc : TEXCOORD)
{
    out_pos = pos;
    tc = float4(0.1, 0.2, 0.3, 0.4);
}

[pixel-shader]
float4 main(float4 pos : sv_position, half4 tc : TEXCOORD) : sv_target
{
    return tc;
}

[test]
draw quad
probe (0, 0) f32(0.1, 0.2, 0.3, 0.4)

[require]
shader model >= 2.0
shader model < 3.0

[pixel shader d3dbc-hex]
% The same as above, but in bytecode format so we test the partial precision
% destination modifier.
ffff0200                                                % ps_2_0
05000051 a00f0001 3f000000 00000000 00000000 00000000   % def c1, 0.5, 0, 0, 0
02000001 800f0000 a0e40000                              % mov r0, c0
03000002 802f0000 80e40000 a0000001                     % add_pp r0, r0, c1.x
02000001 802f0800 80e40000                              % mov_pp oC0, r0
0000ffff                                                % end

