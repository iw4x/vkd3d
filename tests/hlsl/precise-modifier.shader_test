[pixel shader]
// 'precise' is not a keyword
float4 precise;

float4 main() : sv_target
{
    return precise;
}

[test]
uniform 0 float4 0.1 0.2 0.3 0.4
draw quad
probe (0, 0) rgba (0.1, 0.2, 0.3, 0.4)

[pixel shader fail(sm>=6)]
precise float4 var;
typedef float4 precise;

precise main() : sv_target
{
    return var;
}

[test]
uniform 0 float4 0.1 0.2 0.3 0.4
draw quad
probe (0, 0) rgba (0.1, 0.2, 0.3, 0.4)

[pixel shader]
float4 precise;
precise float4 var;

float4 main() : sv_target
{
    return precise;
}

[test]
uniform 0 float4 0.1 0.2 0.3 0.4
draw quad
probe (0, 0) rgba (0.1, 0.2, 0.3, 0.4)

% The precise modifier cannot be used directly on struct definitions.
[pixel shader fail(sm<6)]
precise struct apple
{
    float4 q;
    float4 p;
};

float4 main() : sv_target
{
    return 0;
}
