[pixel shader]
uniform int i;
uniform uint u;
uniform bool b;
uniform float h;

float4 main() : sv_target
{
    return float4(((float)i) + 1.5, ((float)u) - 2.5, ((float)b) / 2, (half)h);
}

[test]
if(sm<4)  write cbv-0  (0) f32(-1)
if(sm<4)  write cbv-0  (4) f32( 3)
if(sm<4)  write cbv-0  (8) f32( 1)
if(sm<4)  write cbv-0 (12) f32( 0.5)
if(sm>=4) write cbv-0  (0) i32(-1)
if(sm>=4) write cbv-0  (1) u32( 3)
if(sm>=4) write cbv-0  (2) i32(-2)
if(sm>=4) write cbv-0  (3) f32( 0.5)
draw quad
probe (0, 0) f32(0.5, 0.5, 0.5, 0.5)

[pixel-shader]
float4 main() : sv_target
{
    int i = -1;
    uint u = 3;
    bool b = true;
    half h = 0.5;
    return float4(((float)i) + 1.5, ((float)u) - 2.5, ((float)b) / 2, h);
}

[test]
draw quad
probe (0, 0) rgba (0.5, 0.5, 0.5, 0.5)
