% Currently vkd3d-shader doesn't actually convert the above into a direct
% index of v#, which d3dcompiler does. That's useful to test, so repeat the
% same test here with the code generated by d3dcompiler_47.
% TODO: Remove this later once we emit v# directly.
[require]
shader model = 4.0

[pixel shader dxbc-tpf-hex]
