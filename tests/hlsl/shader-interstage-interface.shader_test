{
}

[pixel-shader]
struct vertex_out
{
    float4 position : SV_Position;
    nointerpolation float data : TEXCOORD;
};

float4 main(struct vertex_out v) : SV_Target
{
    return float4(v.data, 0.0, 0.0, 1.0);
}

