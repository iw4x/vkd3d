00000003 0000002c 000000b0 000000e4                                     %
4e475349 0000007c 00000004 00000008                                     % .input
00000068 00000000 00000001 00000003 00000000 0000000f                   % .param SV_Position.xyzw, v0.xyzw, float, POS
00000074 00000000 00000000 00000003 00000001 00000f0f                   % .param COLOR0.xyzw, v1.xyzw, float
00000074 00000001 00000000 00000003 00000002 00000f0f                   % .param COLOR1.xyzw, v2.xyzw, float
00000074 00000002 00000000 00000003 00000003 00000f0f                   % .param COLOR2.xyzw, v3.xyzw, float
505f5653 7469736f 006e6f69 4f4c4f43 abab0052                            %
4e47534f 0000002c 00000001 00000008                                     % .output
00000020 00000000 00000000 00000003 00000000 0000000f                   % .param SV_Target.xyzw, o0.xyzw, float, TARGET
545f5653 65677261 abab0074                                              %
52444853 00000098 00000040 00000026                                     % .text ps_4_0
04000059 00208e46 00000000 00000001                                     % dcl_constantBuffer cb0[1], immediateIndexed
03001062 001010f2 00000001                                              % dcl_input_ps linear v1.xyzw
03001062 001010f2 00000002                                              % dcl_input_ps linear v2.xyzw
03001062 001010f2 00000003                                              % dcl_input_ps linear v3.xyzw
03000065 001020f2 00000000                                              % dcl_output o0.xyzw
02000068 00000001                                                       % dcl_temps 1
0400005b 001010f2 00000001 00000003                                     % dcl_indexrange v1.xyzw 3
