% Test that mul(column_major matrix, row_major matrix) is performed as if using
% mad instructions.
[pixel-shader]
float4x4 a;
row_major float4x4 b;

float4 main() : sv_target
{
    float4x4 res = mul(a, b);
    float4x4 madmul;
    float4 p;

    float4 a0 = float4(a._m00, a._m10, a._m20, a._m30);
    float4 a1 = float4(a._m01, a._m11, a._m21, a._m31);
    float4 a2 = float4(a._m02, a._m12, a._m22, a._m32);
    float4 a3 = float4(a._m03, a._m13, a._m23, a._m33);
    float4 b0 = b[0];
    float4 b1 = b[1];
    float4 b2 = b[2];
    float4 b3 = b[3];

    p = mul(a0, b0.x);
    p += mul(a1, b1.x);
    p += mul(a2, b2.x);
    p += mul(a3, b3.x);
    madmul._m00 = p.x;
    madmul._m10 = p.y;
    madmul._m20 = p.z;
    madmul._m30 = p.w;

    p = mul(a0, b0.y);
    p += mul(a1, b1.y);
    p += mul(a2, b2.y);
    p += mul(a3, b3.y);
    madmul._m01 = p.x;
    madmul._m11 = p.y;
    madmul._m21 = p.z;
    madmul._m31 = p.w;

    p = mul(a0, b0.z);
    p += mul(a1, b1.z);
    p += mul(a2, b2.z);
    p += mul(a3, b3.z);
    madmul._m02 = p.x;
    madmul._m12 = p.y;
    madmul._m22 = p.z;
    madmul._m32 = p.w;

    p = mul(a0, b0.w);
    p += mul(a1, b1.w);
    p += mul(a2, b2.w);
    p += mul(a3, b3.w);
    madmul._m03 = p.x;
    madmul._m13 = p.y;
    madmul._m23 = p.z;
    madmul._m33 = p.w;

    return abs(madmul[0] - res[0])
            + abs(madmul[1] - res[1])
            + abs(madmul[2] - res[2])
            + abs(madmul[3] - res[3]);
}

