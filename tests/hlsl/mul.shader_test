% Test that mul(row_major matrix, column_major matrix) is performed using dp4
% instructions.
[pixel-shader]
row_major float4x4 aa, a;
float4x4 b;

float4 main() : sv_target
{
    float4x4 res = mul(aa, b);
    float4x4 dp4mul;

    float4 a0 = a[0];
    float4 a1 = a[1];
    float4 a2 = a[2];
    float4 a3 = a[3];
    float4 b0 = float4(b._m00, b._m10, b._m20, b._m30);
    float4 b1 = float4(b._m01, b._m11, b._m21, b._m31);
    float4 b2 = float4(b._m02, b._m12, b._m22, b._m32);
    float4 b3 = float4(b._m03, b._m13, b._m23, b._m33);

    dp4mul._m00 = dot(a0, b0);
    dp4mul._m01 = dot(a0, b1);
    dp4mul._m02 = dot(a0, b2);
    dp4mul._m03 = dot(a0, b3);
    dp4mul._m10 = dot(a1, b0);
    dp4mul._m11 = dot(a1, b1);
    dp4mul._m12 = dot(a1, b2);
    dp4mul._m13 = dot(a1, b3);
    dp4mul._m20 = dot(a2, b0);
    dp4mul._m21 = dot(a2, b1);
    dp4mul._m22 = dot(a2, b2);
    dp4mul._m23 = dot(a2, b3);
    dp4mul._m30 = dot(a3, b0);
    dp4mul._m31 = dot(a3, b1);
    dp4mul._m32 = dot(a3, b2);
    dp4mul._m33 = dot(a3, b3);

    return abs(dp4mul[0] - res[0])
            + abs(dp4mul[1] - res[1])
            + abs(dp4mul[2] - res[2])
            + abs(dp4mul[3] - res[3]);
}

[test]
write cbv-0  (0) f32(0.1, 0.2, 0.3, 0.4)
write cbv-0  (4) f32(0.5, 0.6, 0.7, 0.8)
write cbv-0  (8) f32(0.9, 1.0, 1.1, 1.2)
write cbv-0 (12) f32(1.3, 1.4, 1.5, 1.6)
write cbv-0 (16) f32(0.1, 0.2, 0.3, 0.4)
write cbv-0 (20) f32(0.5, 0.6, 0.7, 0.8)
write cbv-0 (24) f32(0.9, 1.0, 1.1, 1.2)
write cbv-0 (28) f32(1.3, 1.4, 1.5, 1.6)
write cbv-0 (32) f32(1.7, 1.8, 1.9, 2.0)
write cbv-0 (36) f32(2.1, 2.2, 2.3, 2.4)
write cbv-0 (40) f32(2.5, 2.6, 2.7, 2.8)
write cbv-0 (44) f32(2.9, 3.0, 3.1, 3.2)
draw quad
todo(radv & mesa<26 & sm<3 | radv & mesa>=26 & sm<4 | mvk<1.4.0 & sm<3) probe (0, 0) f32(0, 0, 0, 0)

% Same as the previous test, but test that matrix majority is preserved even if
% the matrices are passed as function parameters.
[pixel-shader]
row_major float4x4 a;
float4x4 b;

float4x4 mulfn(float4x4 mat1, float4x4 mat2)
{
    return mul(mat1, mat2);
}

float4 main() : sv_target
{
    float4x4 res = mulfn(a, b);
    float4x4 dp4mul;

    float4 a0 = a[0];
    float4 a1 = a[1];
    float4 a2 = a[2];
    float4 a3 = a[3];
    float4 b0 = float4(b._m00, b._m10, b._m20, b._m30);
    float4 b1 = float4(b._m01, b._m11, b._m21, b._m31);
    float4 b2 = float4(b._m02, b._m12, b._m22, b._m32);
    float4 b3 = float4(b._m03, b._m13, b._m23, b._m33);

    dp4mul._m00 = dot(a0, b0);
    dp4mul._m01 = dot(a0, b1);
    dp4mul._m02 = dot(a0, b2);
    dp4mul._m03 = dot(a0, b3);
    dp4mul._m10 = dot(a1, b0);
    dp4mul._m11 = dot(a1, b1);
    dp4mul._m12 = dot(a1, b2);
    dp4mul._m13 = dot(a1, b3);
    dp4mul._m20 = dot(a2, b0);
    dp4mul._m21 = dot(a2, b1);
    dp4mul._m22 = dot(a2, b2);
    dp4mul._m23 = dot(a2, b3);
    dp4mul._m30 = dot(a3, b0);
    dp4mul._m31 = dot(a3, b1);
    dp4mul._m32 = dot(a3, b2);
    dp4mul._m33 = dot(a3, b3);

    return abs(dp4mul[0] - res[0])
            + abs(dp4mul[1] - res[1])
            + abs(dp4mul[2] - res[2])
            + abs(dp4mul[3] - res[3]);
}

