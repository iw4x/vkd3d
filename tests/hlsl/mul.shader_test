% Same as the previous tests, but test that the original matrix majority is
% preserved even if the matrices are passed as function parameters.
[pixel-shader]
float4x4 a;
float4 bb, b;

float4 mulfn(row_major float4x4 mat)
{
    return mul(mat, bb);
}

float4 main() : sv_target
{
    float4 res = mulfn(a);
    float4 a0 = float4(a._m00, a._m10, a._m20, a._m30);
    float4 a1 = float4(a._m01, a._m11, a._m21, a._m31);
    float4 a2 = float4(a._m02, a._m12, a._m22, a._m32);
    float4 a3 = float4(a._m03, a._m13, a._m23, a._m33);
    float4 madmul;

    madmul = a0 * b.x;
    madmul += a1 * b.y;
    madmul += a2 * b.z;
    madmul += a3 * b.w;

    return res - madmul;
}

[test]
write cbv-0  (0) f32(0.1, 0.2, 0.3, 0.4)
write cbv-0  (4) f32(0.5, 0.6, 0.7, 0.8)
write cbv-0  (8) f32(0.9, 1.0, 1.1, 1.2)
write cbv-0 (12) f32(1.3, 1.4, 1.5, 1.6)
write cbv-0 (16) f32(1.7, 1.8, 1.9, 2.0)
write cbv-0 (20) f32(1.7, 1.8, 1.9, 2.0)
draw quad
todo(radv & mesa>=26 & sm<4 | mvk<1.4.0 | mvk & sm<4 | msl) probe (0, 0) f32(0, 0, 0, 0)

