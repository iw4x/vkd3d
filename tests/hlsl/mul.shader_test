[pixel-shader]
row_major float2x3 aa, a;
float3x2 b;

float4 main() : sv_target
{
    float2x2 res = mul(aa, b);
    float2x2 dp3mul;

    float3 a0 = a[0];
    float3 a1 = a[1];
    float3 b0 = float3(b._m00, b._m10, b._m20);
    float3 b1 = float3(b._m01, b._m11, b._m21);

    dp3mul._m00 = dot(a0, b0);
    dp3mul._m01 = dot(a0, b1);
    dp3mul._m10 = dot(a1, b0);
    dp3mul._m11 = dot(a1, b1);

    return float4(abs(res - dp3mul));
}

