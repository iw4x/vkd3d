[pixel-shader]
row_major float4x4 a;
float4x4 b;
float4 c, cc;

float4 mulfn(float4x4 m)
{
    // Replacing a component with a constant inhibits dot product vectorization.
    float4 vecH = float4(cc.xyz, 1);

    return mul(vecH, m);
}

float4 main() : sv_target
{
    float4 dp4mul, madmul;
    float4 a0 = a[0];
    float4 a1 = a[1];
    float4 a2 = a[2];
    float4 a3 = a[3];
    float4 b0 = float4(b._m00, b._m10, b._m20, b._m30);
    float4 b1 = float4(b._m01, b._m11, b._m21, b._m31);
    float4 b2 = float4(b._m02, b._m12, b._m22, b._m32);
    float4 b3 = float4(b._m03, b._m13, b._m23, b._m33);

    madmul = c.x * a0;
    madmul += c.y * a1;
    madmul += c.z * a2;
    madmul += 1 * a3;

    dp4mul.x = dot(float4(c.xyz, 1), b0);
    dp4mul.y = dot(float4(c.xyz, 1), b1);
    dp4mul.z = dot(float4(c.xyz, 1), b2);
    dp4mul.w = dot(float4(c.xyz, 1), b3);

    // The first mul() must be performed using mul+add/mad instructions.
    // The second mul() must be performed using dp4 instructions.
    // This means that the matrix majority of function arguments is propagated
    // through function calls, regardless of the majority declared in the
    // parameters.
    return abs(mulfn(a) - madmul) + abs(mulfn(b) - dp4mul);
}

