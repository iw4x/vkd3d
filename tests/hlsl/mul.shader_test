% Test that mul(row_major matrix, row_major matrix) is performed as if using mad
% instructions.
[pixel-shader]
row_major float4x4 aa, a;
row_major float4x4 b;

float4 main() : sv_target
{
    float4x4 res = mul(aa, b);
    float4x4 madmul;
    float4 p;

    float4 a0 = a[0];
    float4 a1 = a[1];
    float4 a2 = a[2];
    float4 a3 = a[3];
    float4 b0 = b[0];
    float4 b1 = b[1];
    float4 b2 = b[2];
    float4 b3 = b[3];

    p = mul(a0.x, b0);
    p += mul(a0.y, b1);
    p += mul(a0.z, b2);
    p += mul(a0.w, b3);
    madmul._m00 = p.x;
    madmul._m01 = p.y;
    madmul._m02 = p.z;
    madmul._m03 = p.w;

    p = mul(a1.x, b0);
    p += mul(a1.y, b1);
    p += mul(a1.z, b2);
    p += mul(a1.w, b3);
    madmul._m10 = p.x;
    madmul._m11 = p.y;
    madmul._m12 = p.z;
    madmul._m13 = p.w;

    p = mul(a2.x, b0);
    p += mul(a2.y, b1);
    p += mul(a2.z, b2);
    p += mul(a2.w, b3);
    madmul._m20 = p.x;
    madmul._m21 = p.y;
    madmul._m22 = p.z;
    madmul._m23 = p.w;

    p = mul(a3.x, b0);
    p += mul(a3.y, b1);
    p += mul(a3.z, b2);
    p += mul(a3.w, b3);
    madmul._m30 = p.x;
    madmul._m31 = p.y;
    madmul._m32 = p.z;
    madmul._m33 = p.w;

    return abs(madmul[0] - res[0])
            + abs(madmul[1] - res[1])
            + abs(madmul[2] - res[2])
            + abs(madmul[3] - res[3]);
}

