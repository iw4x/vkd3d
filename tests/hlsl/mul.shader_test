[require]
shader model < 6.0

% The purpose of the following tests is to check that we are emitting the same
% d3dbc/tpf instructions fxc does for the different mul() cases.
%
% We do this by means of checking that the result is exactly zero when
% subtracting an expression obtained with the equivalent operations.
%
% This is particularly important to avoid z-fighting bugs, since it is common
% for the mul() operation to compute vertex depth.
%
% When we fail to do this, the results are inconsistent across backends, being
% non zero in some of them. This depends on the internal optimizations
% performed by the driver.
%
% Since in SM6 we are not compiling from HLSL directly, and results depend on
% the DXC version and vary from backend to backend, and mul() is implemented
% differently, it is excluded.

% In some test we pass a uniform twice (named e.g. `a` and `aa`) with the same
% value, both to preempt the backends from performing optimizations, and fxc
% itself from simplifying a subtraction of equivalent expressions into zero.
%
% This cannot be done for all tests, in particular matrix-matrix
% multiplications, where we might hit the following error in ps_2_0:
%
%     error X5608: Compiled shader code uses too many arithmetic instruction
%     slots [...]. Max. allowed by the target (ps_2_0) is 64.

% Test that mul(vector, vector) is performed using dp4 instructions.
[pixel-shader]
float4 aa, a;
float4 b;

float4 main() : sv_target
{
    return mul(aa, b) - dot(a, b);
}
[test]
write cbv-0 (0) f32(0.1, 0.2, 0.3, 0.4)
write cbv-0 (4) f32(0.1, 0.2, 0.3, 0.4)
write cbv-0 (8) f32(0.5, 0.6, 0.7, 0.8)
draw quad
todo(radv & mesa<25.1.6 & sm<3 | radv & mesa>=26 & sm<4) probe (0, 0) f32(0, 0, 0, 0)

% Test that mul(vector, column_major matrix) is performed using dp4 instructions.
[pixel-shader]
float4x4 b;
float4 aa, a;

float4 main() : sv_target
{
    float4 res = mul(aa, b);
    float4 b0 = float4(b._m00, b._m10, b._m20, b._m30);
    float4 b1 = float4(b._m01, b._m11, b._m21, b._m31);
    float4 b2 = float4(b._m02, b._m12, b._m22, b._m32);
    float4 b3 = float4(b._m03, b._m13, b._m23, b._m33);
    float4 dp4mul;

    dp4mul.x = dot(a, b0);
    dp4mul.y = dot(a, b1);
    dp4mul.z = dot(a, b2);
    dp4mul.w = dot(a, b3);
    return res - dp4mul;
}
[test]
write cbv-0  (0) f32(0.1, 0.2, 0.3, 0.4)
write cbv-0  (4) f32(0.5, 0.6, 0.7, 0.8)
write cbv-0  (8) f32(0.9, 1.0, 1.1, 1.2)
write cbv-0 (12) f32(1.3, 1.4, 1.5, 1.6)
write cbv-0 (16) f32(1.7, 1.8, 1.9, 2.0)
write cbv-0 (20) f32(1.7, 1.8, 1.9, 2.0)
draw quad
todo(radv & mesa<26 & sm<3 | radv & mesa>=26 & sm<4) probe (0, 0) f32(0, 0, 0, 0)

% Test that mul(vector, row_major matrix) is performed as if using mad instructions.
[pixel-shader]
row_major float4x4 b;
float4 aa, a;

float4 main() : sv_target
{
    float4 res = mul(aa, b);
    float4 b0 = b[0];
    float4 b1 = b[1];
    float4 b2 = b[2];
    float4 b3 = b[3];
    float4 madmul;

    madmul = a.x * b0;
    madmul += a.y * b1;
    madmul += a.z * b2;
    madmul += a.w * b3;

    return res - madmul;
}

[test]
write cbv-0  (0) f32(0.1, 0.2, 0.3, 0.4)
write cbv-0  (4) f32(0.5, 0.6, 0.7, 0.8)
write cbv-0  (8) f32(0.9, 1.0, 1.1, 1.2)
write cbv-0 (12) f32(1.3, 1.4, 1.5, 1.6)
write cbv-0 (16) f32(1.7, 1.8, 1.9, 2.0)
write cbv-0 (20) f32(1.7, 1.8, 1.9, 2.0)
draw quad
todo(radv & mesa>=26 & sm<4 | mvk<1.4.0 | mvk & sm<4 | msl) probe (0, 0) f32(0, 0, 0, 0)

% Test that mul(column_major matrix, vector) is performed as if using mad instructions.
[pixel-shader]
float4x4 a;
float4 bb, b;

float4 main() : sv_target
{
    float4 res = mul(a, bb);
    float4 a0 = float4(a._m00, a._m10, a._m20, a._m30);
    float4 a1 = float4(a._m01, a._m11, a._m21, a._m31);
    float4 a2 = float4(a._m02, a._m12, a._m22, a._m32);
    float4 a3 = float4(a._m03, a._m13, a._m23, a._m33);
    float4 madmul;

    madmul = a0 * b.x;
    madmul += a1 * b.y;
    madmul += a2 * b.z;
    madmul += a3 * b.w;

    return res - madmul;
}

[test]
write cbv-0  (0) f32(0.1, 0.2, 0.3, 0.4)
