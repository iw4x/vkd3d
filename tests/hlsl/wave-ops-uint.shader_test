bug(vulkan & mvk<1.4.0) dispatch 4 1 1
probe uav-1 (0) u32(2)
probe uav-1 (1) u32(2)
probe uav-1 (2) u32(2)
probe uav-1 (3) u32(2)

[compute-shader]
RWBuffer<uint> u0;
RWBuffer<uint> u1;

    [numthreads(4, 1, 1)]
void main(uint id : SV_GroupIndex)
{
    bool b = u0[id] == 8;
    u1[id] = WavePrefixCountBits(b);
}

