[require]
shader model >= 6.0
wave-ops
format r32-uint uav-load

[uav 0]
format r32-uint
size (buffer, 4)

8 15 8 10

[uav 1]
format r32-uint
size (buffer, 8)

0 0 0 0 0 0 0 0

[compute-shader]
RWBuffer<uint> u1 : register(u1);

    [numthreads(4, 1, 1)]
void main(uint id : SV_GroupIndex)
{
    u1[id] = WaveIsFirstLane();
}

[test]
dispatch 4 1 1
probe uav-1 (0) u32(1)
probe uav-1 (1) u32(0)
probe uav-1 (2) u32(0)
probe uav-1 (3) u32(0)

[compute-shader]
RWBuffer<uint> u1 : register(u1);

    [numthreads(4, 1, 1)]
void main(uint id : SV_GroupIndex)
{
    if (!id)
    {
        u1[0] = 0;
        return;
    }
    u1[id] = WaveIsFirstLane();
}

[test]
dispatch 4 1 1
probe uav-1 (0) u32(0)
probe uav-1 (1) u32(1)
probe uav-1 (2) u32(0)
probe uav-1 (3) u32(0)

[compute-shader]
RWBuffer<uint> u1 : register(u1);

    [numthreads(4, 1, 1)]
void main(uint id : SV_GroupIndex)
{
    u1[id] = WaveGetLaneIndex();
}

[test]
dispatch 4 1 1
probe uav-1 (0) u32(0)
probe uav-1 (1) u32(1)
probe uav-1 (2) u32(2)
probe uav-1 (3) u32(3)

[compute-shader]
RWBuffer<uint> u1 : register(u1);

    [numthreads(4, 1, 1)]
void main(uint id : SV_GroupIndex)
{
    // Between 4 and 128, and includes inactive and/or helper lanes.
    uint count = WaveGetLaneCount();
    u1[id] = count >= 4 && count <= 128;
}

[test]
dispatch 4 1 1
probe uav-1 (0) u32(1)
probe uav-1 (1) u32(1)
probe uav-1 (2) u32(1)
probe uav-1 (3) u32(1)

[compute-shader]
RWBuffer<uint> u0;
RWBuffer<uint> u1;

    [numthreads(4, 1, 1)]
void main(uint id : SV_GroupIndex)
{
    uint i = (id & 1) ? -u0[id] : u0[id];
    u1[id] = WaveActiveMin(i);
}

[test]
bug(vulkan & mvk<1.4.0) dispatch 4 1 1
probe uav-1 (0) u32(8)
probe uav-1 (1) u32(8)
probe uav-1 (2) u32(8)
probe uav-1 (3) u32(8)

[compute-shader]
RWBuffer<uint> u0;
RWBuffer<uint> u1;

    [numthreads(4, 1, 1)]
void main(uint id : SV_GroupIndex)
{
    bool b = u0[id] == 8;
    u1[id] = WaveActiveBallot(b).x;
}

[test]
bug(vulkan & mvk<1.4.0) dispatch 4 1 1
probe uav-1 (0) u32(5)
probe uav-1 (1) u32(5)
probe uav-1 (2) u32(5)
probe uav-1 (3) u32(5)

[compute-shader]
RWBuffer<uint> u0;
RWBuffer<uint> u1;

    [numthreads(4, 1, 1)]
void main(uint id : SV_GroupIndex)
{
    uint i = u0[id] + u0[id ^ 1];
    u1[id] = WaveReadLaneFirst(i);
}

[test]
bug(vulkan & mvk<1.4.0) dispatch 4 1 1
probe uav-1 (0) u32(23)
probe uav-1 (1) u32(23)
probe uav-1 (2) u32(23)
probe uav-1 (3) u32(23)

[compute-shader]
RWBuffer<uint> u0;
RWBuffer<uint> u1;

    [numthreads(4, 1, 1)]
void main(uint id : SV_GroupIndex)
{
    uint i = u0[id] + u0[id ^ 1];
    u1[id] = WaveReadLaneAt(i, 3);
}

[test]
bug(vulkan & mvk<1.4.0) dispatch 4 1 1
probe uav-1 (0) u32(18)
probe uav-1 (1) u32(18)
probe uav-1 (2) u32(18)
probe uav-1 (3) u32(18)

[compute-shader]
RWBuffer<uint> u0;
RWBuffer<uint> u1;

    [numthreads(4, 1, 1)]
void main(uint id : SV_GroupIndex)
{
    uint i = u0[id] + u0[id ^ 1];
    // Non-uniform lane index
    u1[id] = WaveReadLaneAt(i, (id + 2) & 3);
}

[test]
bug(vulkan & mvk<1.4.0) dispatch 4 1 1
probe uav-1 (0) u32(18)
probe uav-1 (1) u32(18)
probe uav-1 (2) u32(23)
probe uav-1 (3) u32(23)

[compute-shader]
RWBuffer<uint> u0;
RWBuffer<uint> u1;

    [numthreads(4, 1, 1)]
void main(uint id : SV_GroupIndex)
{
    bool b = u0[id] == 8;
    u1[id] = WaveActiveCountBits(b);
}

