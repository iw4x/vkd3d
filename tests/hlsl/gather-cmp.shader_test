% In general comparison gather only makes sense for textures with a single
% channel. Drivers have lots of inconsistent behaviour for textures with more
% than one channel. The only somewhat meaningful way to test
% GatherCmp{Green,Blue,Alpha}() is to swizzle the SRV, and even then NVIDIA
% GPUs still get that wrong because they always look at the R channel of the
% swizzle rather than G, B or A.

[require]
shader model >= 5.0
texture-swizzle

[srv-0]
format r32-float-shadow
size (2d, 3, 3)
swizzle 0r00

0.0 0.0 0.0
0.4 0.1 0.0
0.5 0.0 0.2

[pixel shader]
SamplerComparisonState s;
Texture2D t;

float4 main() : sv_target
{
    return t.GatherCmpGreen(s, float2(0.2, 0.2), 0.1, int2(0, 0));
}

