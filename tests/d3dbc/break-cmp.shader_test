[require]
shader model = 3.0

[rtv-0]
format r32g32b32a32-float
size (2d, 64, 64)

[vertex-shader]
void main(float4 p : POSITION, out float4 t : TEXCOORD, out float4 position : SV_Position)
{
    position = t = p;
}

[pixel-shader d3dbc-hex]
ffff0300                                                % ps_3_0
05000030 f00f0000 00000001 00000000 00000000 00000000   % defi i0, 1, 0, 0, 0
05000051 a00f0000 41000000 3e000000 3f800000 00000000   % def c0, 8, 0.125, 1, 0
0200001f 80000005 90030000                              % dcl_texcoord v0.xy
03000005 80030000 90e40000 a0000000                     % mul r0.xy, v0, c0.x
02000013 800c0000 80400000                              % frc r0.zw, r0.xxxy
03000002 80030000 80e40000 81fe0000                     % add r0.xy, r0, -r0.zwww
03000005 80030000 80e40000 a0550000                     % mul r0.xy, r0, c0.y
02000001 800f0001 a0bb0000                              % mov r1, c0.wzwz
01000026 f0e40000                                       % rep i0
0201002d 80000000 80550000                              %     break_gt r0.x, r0.y
02000001 800f0001 a0be0000                              %     mov r1, c0.zwwz
00000027                                                % endrep
02000001 800f0800 80e40001                              % mov oC0, r1
0000ffff                                                % end

[test]
draw quad
probe (30,  2) f32(1, 0, 0, 1)
probe (22, 18) f32(1, 0, 0, 1)
probe (46, 18) f32(1, 0, 0, 1)
probe (62, 26) f32(0, 1, 0, 1)
probe ( 6, 34) f32(1, 0, 0, 1)
probe (22, 42) f32(1, 0, 0, 1)
probe (46, 42) f32(0, 1, 0, 1)
probe (38, 58) f32(0, 1, 0, 1)

