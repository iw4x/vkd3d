[require]
shader model = 2.0

[rtv-0]
format r32g32b32a32-float
size (2d, 64, 64)

[vertex-shader d3dbc-hex]
fffe0200                                                % vs_2_0
0200001f 80000000 900f0000                              % dcl_position v0
02000001 c00f0000 90e40000                              % mov oPos, v0
02000001 e0030000 90e40000                              % mov oT0.xy, v0
0000ffff                                                % ret

% The fragment shader declares t0 with the full .xyzw mask, although it only
% uses t0.xy. The vertex shader only writes oT0.xy. This is supposed to work.
[pixel-shader d3dbc-hex]
ffff0200                                                % ps_2_0
0200001f 80000000 b00f0000                              % dcl t0
05000051 a00f0000 40800000 3e800000 00000000 00000000   % def c0, 4, 0.25, 0, 0
03000005 80030000 b0e40000 a0000000                     % mul r0.xy, t0, c0.x
02000013 800c0000 801b0000                              % frc r0.zw, r0.wzyx
03000002 80030000 80e40000 811b0000                     % add r0.xy, r0, -r0.wzyx
03000005 80030000 80e40000 a0550000                     % mul r0.xy, r0, c0.y
02000001 800c0000 801b0000                              % mov r0.zw, r0.wzyx
02000001 800f0800 80e40000                              % mov oC0, r0
0000ffff                                                % ret

[test]
draw quad
probe ( 4,  4) f32(-1.0,  .75,  .75, -1.0)
probe (20, 20) f32(-0.5,  .25,  .25, -0.5)
probe (36, 36) f32( 0.0, -.25, -.25,  0.0)
probe (52, 52) f32( 0.5, -.75, -.75,  0.5)
