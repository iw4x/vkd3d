[require]
shader model = 2.0

[rtv-0]
format r32g32b32a32-float
size (2d, 64, 64)

[srv-0]
format r32-float
size (2d, 16, 1)
-1.000 -0.875 -0.750 -0.625
-0.500 -0.375 -0.250 -0.125
 0.000  0.125  0.250  0.375
 0.500  0.625  0.750  0.875

[srv-1]
format r32-float
size (2d, 16, 1)
-1.000 -0.875 -0.750 -0.625
-0.500 -0.375 -0.250 -0.125
 0.000  0.125  0.250  0.375
 0.500  0.625  0.750  0.875

[sampler-0]
filter point point point
address clamp clamp clamp

[sampler-1]
filter point point point
address clamp clamp clamp

[vertex-shader]
void main(float4 p : POSITION, out float4 t0 : TEXCOORD0,
        out float4 t1 : TEXCOORD1, out float4 position : SV_Position)
{
    t0 = float4(p.x / 2 + 0.5, 0.5, 0.0, 1.0);
    t1 = float4(p.y / 2 + 0.5, 0.5, 0.0, 1.0);
    position = p;
}

% The documentation for the "sub" instruction claims it's supported by all
% d3dbc shader models. In a certain sense that's true; the assembler will
% happily accept "sub" instructions in e.g. ps_2_0 or ps_3_0 shaders. However,
% the bytecode it emits contains an "add" instruction with an appropriate
% modifier on the second source operand. I was unable to make Windows accept a
% ps_2_0 or ps_3_0 shader containing an actual "sub" (0x03000003) instruction.
[pixel-shader d3dbc-hex]
ffff0104                                                % ps_1_4
00000042 800f0000 b0e40001                              % texld r0, t1
00000042 800f0001 b0e40000                              % texld r1, t0
00000001 80020001 80000000                              % mov r1.y, r0.x
00000002 80040001 80550001 80550001                     % add r1.z, r1.y, r1.y
00000002 80080001 80000001 80000001                     % add r1.w, r1.x, r1.x
00000003 800f0000 a0e40000 81e40001                     % sub r0, c0, -r1
0000ffff                                                % end

[test]
write cbv-f32 (0) f32(-0.125, -0.25, 0.5, 0.75)
draw quad
probe ( 2,  2) f32(0.000, 0.625, 1.000, 0.00)
probe (10, 10) f32(0.000, 0.375, 1.000, 0.00)
probe (18, 18) f32(0.000, 0.125, 1.000, 0.00)
probe (26, 26) f32(0.000, 0.000, 0.750, 0.25)
probe (34, 34) f32(0.000, 0.000, 0.250, 0.75)
probe (42, 42) f32(0.125, 0.000, 0.000, 1.00)
probe (50, 50) f32(0.375, 0.000, 0.000, 1.00)
probe (58, 58) f32(0.625, 0.000, 0.000, 1.00)

[pixel-shader d3dbc-hex]
ffff0104                                                % ps_1_4
00000042 800f0000 b0e40001                              % texld r0, t1
00000042 800f0001 b0e40000                              % texld r1, t0
00000001 80020001 80000000                              % mov r1.y, r0.x
00000002 80040001 80550001 80550001                     % add r1.z, r1.y, r1.y
00000002 80080001 80000001 80000001                     % add r1.w, r1.x, r1.x
00000003 800f0000 a0e40000 80e40001                     % sub r0, c0, r1
0000ffff                                                % end

[test]
write cbv-f32 (0) f32(-0.125, -0.25, 0.5, 0.75)
draw quad
probe ( 2,  2) f32(0.875, 0.000, 0.000, 1.00)
probe (10, 10) f32(0.625, 0.000, 0.000, 1.00)
probe (18, 18) f32(0.375, 0.000, 0.000, 1.00)
probe (26, 26) f32(0.125, 0.000, 0.250, 1.00)
probe (34, 34) f32(0.000, 0.000, 0.750, 0.75)
probe (42, 42) f32(0.000, 0.125, 1.000, 0.25)
probe (50, 50) f32(0.000, 0.375, 1.000, 0.00)
probe (58, 58) f32(0.000, 0.625, 1.000, 0.00)
