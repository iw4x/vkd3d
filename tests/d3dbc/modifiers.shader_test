[require]
shader model = 2.0

[rtv-0]
format r32g32b32a32-float
size (2d, 64, 64)

[srv-0]
format r32-float
size (2d, 16, 1)
-1.000 -0.875 -0.750 -0.625
-0.500 -0.375 -0.250 -0.125
 0.000  0.125  0.250  0.375
 0.500  0.625  0.750  0.875

[srv-1]
format r32-float
size (2d, 16, 1)
-1.000 -0.875 -0.750 -0.625
-0.500 -0.375 -0.250 -0.125
 0.000  0.125  0.250  0.375
 0.500  0.625  0.750  0.875

[sampler-0]
filter point point point
address clamp clamp clamp

[sampler-1]
filter point point point
address clamp clamp clamp

[vertex-shader]
void main(float4 p : POSITION, out float4 t0 : TEXCOORD0,
        out float4 t1 : TEXCOORD1, out float4 position : SV_Position)
{
    t0 = float4(p.x / 2 + 0.5, 0.5, 0.0, 1.0);
    t1 = float4(p.y / 2 + 0.5, 0.5, 0.0, 1.0);
    position = p;
}

[pixel-shader d3dbc-hex]
ffff0104                                                % ps_1_4
00000042 800f0000 b0e40001                              % texld r0, t1
00000042 800f0001 b0e40000                              % texld r1, t0
00000001 80020001 80000000                              % mov r1.y, r0.x
00000001 81040001 80550001                              % mov_x2 r1.z, r1.y
00000001 81080001 80000001                              % mov_x2 r1.w, r1.x
00000001 800f0000 80e40001                              % mov r0, r1
0000ffff                                                % end

[test]
draw quad
todo probe ( 2,  2) f32(.00, .875, 1.00, 0.0)
todo probe (10, 10) f32(.00, .625, 1.00, 0.0)
todo probe (18, 18) f32(.00, .375, 0.75, 0.0)
todo probe (26, 26) f32(.00, .125, 0.25, 0.0)
probe (34, 34) f32(.00, .000, 0.00, 0.0)
todo probe (42, 42) f32(.25, .000, 0.00, 0.5)
todo probe (50, 50) f32(.50, .000, 0.00, 1.0)
todo probe (58, 58) f32(.75, .000, 0.00, 1.0)

[pixel-shader d3dbc-hex]
ffff0104                                                % ps_1_4
00000042 800f0000 b0e40001                              % texld r0, t1
00000042 800f0001 b0e40000                              % texld r1, t0
00000001 80020001 80000000                              % mov r1.y, r0.x
00000001 81040001 80550001                              % mov_x2 r1.z, r1.y
00000001 81080001 80000001                              % mov_x2 r1.w, r1.x
00000001 800f0000 81e40001                              % mov r0, -r1
0000ffff                                                % end

[test]
draw quad
probe ( 2,  2) f32(1.00, .000, 0.00, 1.0)
todo probe (10, 10) f32(0.75, .000, 0.00, 1.0)
todo probe (18, 18) f32(0.50, .000, 0.00, 1.0)
